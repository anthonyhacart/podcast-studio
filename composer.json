{
    "name": "anthonyhacart/podcast-studio",
    "description": "Ask your AI assistant for a podcast episode: an MCP server where two AI hosts write, voice and remember, built with Symfony AI.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "mcp/sdk": "*@beta",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "dev-main as 1.0.0-BETA2",
        "symfony/ai-bundle": "dev-main as 1.0.0-BETA2",
        "symfony/ai-generic-platform": "dev-main as 1.0.0-BETA2",
        "symfony/ai-mistral-platform": "dev-main as 1.0.0-BETA2",
        "symfony/ai-platform": "dev-main as 1.0.0-BETA2",
        "symfony/ai-postgres-store": "dev-main as 1.0.0-BETA2",
        "symfony/ai-store": "dev-main as 1.0.0-BETA2",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mcp-bundle": "dev-main as 1.0.0-BETA2",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.12.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/panther": "^2.4",
        "symfony/ux-toolkit": "^3.6",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
