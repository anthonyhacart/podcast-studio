<p>{{ brief.topic }}</p>
{% if brief.questions %}
    <p>Listener questions:</p>
    <ul>
        {% for question in brief.questions %}
            <li>{{ question.name ?? 'A listener' }}: {{ question.text }}</li>
        {% endfor %}
    </ul>
{% endif %}
<p>Sources:</p>
<ul>
    {% for source in brief.sources %}
        <li>{% if source.url %}<a href="{{ source.url }}">{{ source.title }}</a>{% else %}{{ source.title }}{% endif %}</li>
    {% endfor %}
</ul>
